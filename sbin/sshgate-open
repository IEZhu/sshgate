#!/bin/bash
# sshgate-open - privileged helper. Open PORT for a validated IPv4 and record open-time.
# Closing is delegated to sshgate-reap: the rule is removed only when it is
# >= 24h old AND has zero active established sessions from that IP.
# Invoke ONLY via sudo from the unprivileged 'sshgate' service user.
set -euo pipefail

PORT="${SSHGATE_PORT:-22}"
STATE_DIR="${SSHGATE_STATE_DIR:-/var/lib/sshgate/opens}"
UFW=/usr/sbin/ufw

IP="${1:-}"
[[ "$IP" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || { echo "bad ip format" >&2; exit 2; }
for octet in ${IP//./ }; do
  (( 10#$octet >= 0 && 10#$octet <= 255 )) || { echo "bad octet" >&2; exit 2; }
done

mkdir -p "$STATE_DIR"

# add the allow rule only if an identical one is not already present (dedup by tuple)
if ! "$UFW" status | awk -v ip="$IP" -v p="${PORT}/tcp" '$1==p && $2=="ALLOW" && $3==ip {f=1} END{exit !f}'; then
  out="$("$UFW" insert 1 allow from "$IP" to any port "$PORT" proto tcp comment "sshgate" 2>&1 || true)"
  echo "$out" | grep -qiE "Rule inserted|Skipping inserting existing rule" \
    || { echo "ufw failed: $out" >&2; exit 3; }
fi

# record / refresh the open time (this resets the minimum-hold clock)
date +%s > "$STATE_DIR/$IP"

logger -t sshgate "opened tcp/${PORT} for ${IP}"
echo "opened ${IP}"
