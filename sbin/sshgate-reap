#!/bin/bash
# sshgate-reap - remove an opening only when it is >= HOLD seconds old AND has no
# active (established) sessions on PORT from that IP. Run periodically by the timer,
# so access is held at least HOLD, then kept until the last session disconnects.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin:$PATH

PORT="${SSHGATE_PORT:-22}"
STATE_DIR="${SSHGATE_STATE_DIR:-/var/lib/sshgate/opens}"
HOLD="${SSHGATE_MIN_AGE:-86400}"   # 24h minimum; override only for testing
DRYRUN="${SSHGATE_DRYRUN:-0}"
UFW=/usr/sbin/ufw
[[ "$PORT" =~ ^[0-9]{1,5}$ ]] && (( 10#$PORT >= 1 && 10#$PORT <= 65535 )) \
  || { echo "bad port" >&2; exit 2; }
[[ "$HOLD" =~ ^[0-9]{1,9}$ ]] || { echo "bad minimum age" >&2; exit 2; }
[[ "$DRYRUN" == 0 || "$DRYRUN" == 1 ]] || { echo "bad dry-run value" >&2; exit 2; }

now=$(date +%s)
[ -d "$STATE_DIR" ] || exit 0
shopt -s nullglob

for f in "$STATE_DIR"/*; do
  ip=$(basename "$f")
  [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || continue   # skip junk names
  for octet in ${ip//./ }; do
    (( 10#$octet <= 255 )) || continue 2
  done
  epoch=$(head -1 "$f" 2>/dev/null) || continue
  [[ "$epoch" =~ ^[0-9]{1,12}$ ]] || continue
  age=$(( now - 10#$epoch ))
  if ! sessions=$(ss -Htn state established dst "$ip" "( sport = :$PORT )" 2>/dev/null); then
    echo "cannot inspect sessions for $ip; keeping rule" >&2
    continue
  fi
  active=$(printf '%s' "$sessions" | awk 'NF {n++} END {print n+0}')

  if (( age >= 10#$HOLD && active == 0 )); then
    if (( DRYRUN )); then echo "would-close $ip (age=${age}s active=0)"; continue; fi
    if ! "$UFW" delete allow from "$ip" to any port "$PORT" proto tcp >/dev/null 2>&1; then
      echo "cannot close $ip; keeping state for retry" >&2
      continue
    fi
    rm -f "$f"
    logger -t sshgate "closed tcp/${PORT} for ${ip} (age ${age}s, idle)"
  else
    if (( DRYRUN )); then echo "keep $ip (age=${age}s active=${active})"; fi
  fi
done
